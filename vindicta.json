        "enabled": false,
        "branch": "",
        "autoCommit": false,
        "autoPush": false
      },
      "labels": [],
      "roleIds": [],
      "sprintId": "12slsJflpL2jT_nJBM-44",
      "comments": [
        {
          "id": "3Yb2B6QHVuKGIZNr7yY5F",
          "text": "Implemented the Tauri backend command layer for listing local models and generating speech through a bundled sherpa-onnx executable. It validates input, resolves resource paths, writes WAV output under app data, and returns playback bytes. Real runtime/model assets are still required for end-to-end generation.\n\nChanged files:\n- src-tauri/src/tts.rs\n- src-tauri/src/lib.rs\n- types/tts.ts\n- composables/useTts.ts",
