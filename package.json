{
  "name": "varg-workspace",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  },
  "scripts": {
    "desktop:dev": "pnpm --filter desktop tauri:dev",
